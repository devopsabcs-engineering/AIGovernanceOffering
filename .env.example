# AI Governance Workshop configuration template.
# Copy this file to .env and fill in values, or let the notebooks prompt you
# and persist the answers here automatically. Never commit your real .env file.
#
# Format notes:
#   - Do NOT wrap values in quotes.
#   - Do NOT leave trailing spaces after a value.
#   - Values shown below are placeholders/examples only - replace them.

# ---------------------------------------------------------------------------
# Azure subscription + APIM (required)
# ---------------------------------------------------------------------------

# Azure subscription GUID that contains the APIM instance.
# Optional: if left blank, the az CLI default subscription is used.
# Find it with: az account show --query id -o tsv
# Example: 00000000-0000-0000-0000-000000000000
AZURE_SUBSCRIPTION_ID=

# Resource group containing the existing APIM instance.
# Find it with: az apim list --query "[].{name:name,rg:resourceGroup}" -o table
# Example: AIGovernanceOffering
APIM_RESOURCE_GROUP=

# Name of the existing APIM instance (not the gateway URL).
# Example: AIGovernanceOffering
APIM_NAME=

# Optional: client ID (GUID) of a user-assigned managed identity attached to
# APIM. When set, the notebooks add client-id to authentication-managed-identity
# policies, backend managed-identity credentials, and the Demo 2 logger. Leave
# blank to keep using the APIM system-assigned identity.
APIM_IDENTITY_CLIENT_ID=

# ---------------------------------------------------------------------------
# Azure OpenAI / Microsoft Foundry backend (required for Demo 1 and later)
# ---------------------------------------------------------------------------

# AOAI_ENDPOINT must be the resource ROOT with no path and no trailing slash:
#   Microsoft Foundry: https://<your-resource>.services.ai.azure.com
#   Azure OpenAI:      https://<your-resource>.openai.azure.com
# Example: https://aigovernanceoffering.services.ai.azure.com
AOAI_ENDPOINT=

# The model DEPLOYMENT name you created in the portal (not the model name,
# though they often match).
# Example: gpt-4o
AOAI_DEPLOYMENT=

# Optional: Azure OpenAI API key, only used as a fallback when managed identity
# authentication from APIM to Azure OpenAI is not configured. Leave blank to
# prefer managed identity.
AOAI_KEY=

# Request surface to use: 'v1' for Microsoft Foundry
# (/openai/v1/chat/completions, deployment sent in the body as "model") or
# 'classic' for Azure OpenAI (/openai/deployments/<deployment>/chat/completions).
# Use 'v1' if your AOAI_ENDPOINT ends in .services.ai.azure.com
AOAI_API_STYLE=v1

# Optional: override the API version used for Azure OpenAI calls (classic style only)
AOAI_API_VERSION=2024-10-21

# ---------------------------------------------------------------------------
# Demo run identifier
# ---------------------------------------------------------------------------

# Unique suffix baked into the Demo 1 token-limit counter key. Regenerating
# this value instantly resets the Demo 1 rate/quota counters. Demo 2 also sends
# it as x-demo-run for request traceability, but does not use it as a metric
# dimension because ClientApp must remain bounded.
# Use a short lowercase hex string unique to you (8 chars works well):
#   python -c "import uuid; print(uuid.uuid4().hex[:8])"
# Example: a1b2c3d4
DEMO_RUN=

# ---------------------------------------------------------------------------
# Application Insights (optional, used by Demo 2)
# ---------------------------------------------------------------------------
# Application Insights resource that receives the Demo 2 token metrics. Demo 2
# never reuses another APIM logger: provide APP_INSIGHTS_RESOURCE_ID or
# APP_INSIGHTS_NAME plus the connection string so the notebook can create its
# own logger (demo2-application-insights) and API diagnostic.

# Short name of the Application Insights component.
# Example: ApimAppInsights
APP_INSIGHTS_NAME=

# Full ARM resource ID of the Application Insights component. Format:
# /subscriptions/<subscription-id>/resourceGroups/<rg>/providers/microsoft.insights/components/<name>
APP_INSIGHTS_RESOURCE_ID=

# Connection string from the Application Insights Overview blade. Keep it on a
# single line; it contains several semicolon-separated key=value pairs, e.g.:
# InstrumentationKey=<guid>;IngestionEndpoint=https://<region>.in.applicationinsights.azure.com/;LiveEndpoint=https://<region>.livediagnostics.monitor.azure.com/;ApplicationId=<guid>
# Treat this as a secret - never commit the real value.
APP_INSIGHTS_CONNECTION_STRING=

# Demo 2 creates its own logger (demo2-application-insights) with the
# connection string plus managed-identity ingestion: APIM_IDENTITY_CLIENT_ID
# when set, otherwise SystemAssigned. Grant that APIM identity 'Monitoring
# Metrics Publisher' on the Application Insights resource. Only for an
# Application Insights resource that still accepts local authentication, you
# may opt in to a connection-string-only logger (rejected in headless runs):
# DEMO2_ALLOW_LOCAL_AUTH_LOGGER=true

# ---------------------------------------------------------------------------
# Azure AI Content Safety (required for Demo 3)
# ---------------------------------------------------------------------------
# Demo 3 applies the APIM llm-content-safety policy against an Azure AI
# Content Safety resource. Create one (kind "Content Safety") if you don't
# have one yet, then grant the APIM system-assigned managed identity the
# 'Cognitive Services User' role on it (preferred), or supply a key below.

# Resource root, no path and no trailing slash.
# Find it on the resource's Keys and Endpoint page.
# Example: https://aigovernanceoffering-cs.cognitiveservices.azure.com
CONTENT_SAFETY_ENDPOINT=

# Optional: Azure AI Content Safety API key, only used as a fallback when
# managed identity authentication from APIM to Content Safety is not
# configured. Leave blank to prefer managed identity.
CONTENT_SAFETY_KEY=

# Optional: id of a blocklist created in Azure AI Content Safety Studio.
# Leave blank to skip blocklist enforcement (the policy comments it out).
CONTENT_SAFETY_BLOCKLIST_ID=

# Severity thresholds for the four llm-content-safety harm categories, on the
# 0 (most restrictive) - 7 (least restrictive) EightSeverityLevels scale.
# Content scoring at or above the threshold is blocked with a 403. Choosing
# these values is a Responsible AI business decision, not an engineering
# default -- involve your Responsible AI reviewers before changing them.
# Default: 4 for all four categories.
CONTENT_SAFETY_THRESHOLD_HATE=4
CONTENT_SAFETY_THRESHOLD_SELFHARM=4
CONTENT_SAFETY_THRESHOLD_SEXUAL=4
CONTENT_SAFETY_THRESHOLD_VIOLENCE=4

# ---------------------------------------------------------------------------
# Demo 4 resilient backend pool (optional)
# ---------------------------------------------------------------------------
# No mock-origin variables are needed: routing mode creates an APIM-hosted mock
# API and named-value fault switches on the existing APIM instance. Leave these
# real backend endpoints and deployments blank to use AOAI_ENDPOINT and
# AOAI_DEPLOYMENT for inference mode on all three logical members. For a real
# pool, every deployment must use the same model and version.
# DEMO4_PTU_EAST_ENDPOINT=https://<east-resource>.openai.azure.com
# DEMO4_PTU_CENTRAL_ENDPOINT=https://<central-resource>.openai.azure.com
# DEMO4_PAYG_ENDPOINT=https://<payg-resource>.openai.azure.com
# DEMO4_PTU_EAST_DEPLOYMENT=<same-as-AOAI_DEPLOYMENT>
# DEMO4_PTU_CENTRAL_DEPLOYMENT=<same-as-AOAI_DEPLOYMENT>
# DEMO4_PAYG_DEPLOYMENT=<same-as-AOAI_DEPLOYMENT>

# ---------------------------------------------------------------------------
# Automated sessions (optional; leave commented out for interactive use)
# ---------------------------------------------------------------------------
# AIGOV_HEADLESS=1 makes every missing value an error instead of a prompt and
# rejects inherited environment values that differ from this file. The SESSION_*
# keys enable the shared request budget; without them interactive runs only
# count requests. Limits must cover config/session-envelope.json totals.
# Results are written under outputs/ at the repository root.
# AIGOV_HEADLESS=1
# SESSION_ID=<run-id>-<attempt>
# SESSION_MAX_ATTEMPTS=200
# SESSION_MAX_RESERVED_TOKENS=8000
# SESSION_MAX_ESTIMATED_USD=1.00
# SESSION_DEADLINE_UTC=2026-01-01T00:00:00Z
#
# In an automated session, scripts/lab_session.py write-env replaces this file
# with the notebook keys it needs (DEMO4_* and *_KEY values empty, so managed
# identity is used) plus these deployment outputs, which only the automation
# scripts read:
# AZURE_TENANT_ID, APIM_RESOURCE_ID, APIM_GATEWAY_URL, AOAI_ACCOUNT_RESOURCE_ID,
# CONTENT_SAFETY_RESOURCE_ID, LOG_ANALYTICS_WORKSPACE_CUSTOMER_ID,
# PLATFORM_LOGGER_ID, PLATFORM_API_ID, PLATFORM_API_PATH, TOKEN_METRIC_NAMESPACE,
# CLIENT_APP_ALLOWLIST, TEAM_PRODUCT_IDS, TEAM_SUBSCRIPTION_IDS, AIGOV_GENERATION

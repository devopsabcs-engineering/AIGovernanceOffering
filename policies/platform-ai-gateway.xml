<policies>
  <inbound>
    <!--
      Platform AI gateway policy (API scope, owned by infra/modules/platform-api.bicep).
      Product policies (per-team token limits) run first through base.
      The managed identity client ID comes from a Bicep-owned named value;
      no identifier or key is stored in this file.
    -->
    <base />
    <set-header name="Ocp-Apim-Subscription-Key" exists-action="delete" />
    <set-query-parameter name="subscription-key" exists-action="delete" />
    <set-header name="api-key" exists-action="delete" />
    <set-backend-service backend-id="ai-gateway-foundry" />
    <authentication-managed-identity resource="https://cognitiveservices.azure.com" client-id="{{ai-gateway-identity-client-id}}" />
    <!-- ClientApp allowlist: any other x-client-app value is reported as "unknown". -->
    <llm-emit-token-metric namespace="aigov">
      <dimension name="API ID" />
      <dimension name="Subscription ID" />
      <dimension name="ClientApp" value='@{ var app = context.Request.Headers.GetValueOrDefault("x-client-app", "").Trim().ToLowerInvariant(); return (app == "retail-web" || app == "finance-batch" || app == "hr-assistant") ? app : "unknown"; }' />
    </llm-emit-token-metric>
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>

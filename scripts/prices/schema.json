{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/devopsabcs-engineering/AIGovernanceOffering/scripts/prices/schema.json",
  "title": "AI Governance lab price snapshot",
  "description": "Retail model-token prices used for estimated showback. Exactly one record per meter must match model, version, SKU, region, currency, and effective period; missing or duplicate matches suppress cost totals. Real snapshots are created only after the model tuple is approved.",
  "type": "object",
  "additionalProperties": false,
  "required": ["snapshot_id", "source", "retrieved_at", "currency", "records"],
  "properties": {
    "snapshot_id": {"type": "string", "pattern": "^[A-Za-z0-9_.\\-]{1,64}$"},
    "source": {"type": "string", "minLength": 1, "maxLength": 200},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "currency": {"const": "USD"},
    "fixture": {"type": "boolean", "description": "True for test-only snapshots that must never price real runs."},
    "notes": {"type": "string", "maxLength": 500},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["model", "version", "sku", "region", "currency", "effective_from", "effective_to", "meter", "meter_id", "unit", "unit_price"],
        "properties": {
          "model": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "sku": {"type": "string", "minLength": 1, "description": "Deployment SKU, for example Standard or GlobalStandard."},
          "region": {"type": "string", "minLength": 1, "description": "Pricing region, compared case-insensitively without spaces."},
          "currency": {"const": "USD"},
          "effective_from": {"type": "string", "format": "date-time"},
          "effective_to": {"type": ["string", "null"], "format": "date-time", "description": "Exclusive end; null means open-ended."},
          "meter": {"enum": ["input", "output"], "description": "Uncached input or output tokens; cached-input meters are excluded from the estimate."},
          "meter_id": {"type": "string", "minLength": 1},
          "unit": {"enum": ["per_million_tokens", "per_thousand_tokens"]},
          "unit_price": {"type": "number", "minimum": 0}
        }
      }
    }
  }
}

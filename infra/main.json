{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "languageVersion": "2.0",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.47.16.16243",
      "templateHash": "9339959729459780872"
    },
    "description": "AI Governance lab platform (resource group scope): API Management v2 AI gateway, model and Content Safety accounts, and monitoring."
  },
  "definitions": {
    "teamConfig": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "metadata": {
            "description": "Product ID, also the subscription ID prefix, for example team-retail."
          }
        },
        "displayName": {
          "type": "string",
          "metadata": {
            "description": "Display name of the product."
          }
        },
        "tokensPerMinute": {
          "type": "int",
          "minValue": 1,
          "metadata": {
            "description": "Tokens per minute for each subscription of this product."
          }
        },
        "dailyTokenQuota": {
          "type": "int",
          "minValue": 1,
          "metadata": {
            "description": "Daily token quota for each subscription of this product."
          }
        }
      },
      "metadata": {
        "description": "One team product with its own subscription, token rate limit, and daily token quota.",
        "__bicep_imported_from!": {
          "sourceTemplate": "modules/platform-api.bicep"
        }
      }
    }
  },
  "parameters": {
    "environmentName": {
      "type": "string",
      "defaultValue": "lab",
      "minLength": 2,
      "maxLength": 8,
      "metadata": {
        "description": "Short environment name used in resource names (LZA-aligned)."
      }
    },
    "instanceNumber": {
      "type": "string",
      "defaultValue": "001",
      "minLength": 3,
      "maxLength": 3,
      "metadata": {
        "description": "Three-digit instance number used in resource names (LZA-aligned)."
      }
    },
    "generation": {
      "type": "string",
      "minLength": 2,
      "maxLength": 4,
      "metadata": {
        "description": "Ownership generation, for example g01. Use a new generation when tombstones of a previous generation block name reuse."
      }
    },
    "nameSuffix": {
      "type": "string",
      "minLength": 4,
      "maxLength": 6,
      "metadata": {
        "description": "Deterministic suffix for globally unique names; the bootstrap script sets it once as AIGOV_NAME_SUFFIX."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for API Management and monitoring resources."
      }
    },
    "aiLocation": {
      "type": "string",
      "metadata": {
        "description": "Approved Azure region for the model account and chat deployment."
      }
    },
    "contentSafetyLocation": {
      "type": "string",
      "defaultValue": "[parameters('aiLocation')]",
      "metadata": {
        "description": "Approved Azure region for the Content Safety account."
      }
    },
    "publisherEmail": {
      "type": "string",
      "metadata": {
        "description": "API Management publisher email."
      }
    },
    "publisherName": {
      "type": "string",
      "metadata": {
        "description": "API Management publisher name."
      }
    },
    "sku": {
      "type": "string",
      "defaultValue": "BasicV2",
      "allowedValues": [
        "BasicV2",
        "StandardV2"
      ],
      "metadata": {
        "description": "API Management SKU (LZA-aligned)."
      }
    },
    "skuCount": {
      "type": "int",
      "defaultValue": 1,
      "minValue": 1,
      "maxValue": 10,
      "metadata": {
        "description": "API Management scale units (LZA-aligned)."
      }
    },
    "apimIdentityResourceId": {
      "type": "string",
      "metadata": {
        "description": "Resource ID of the bootstrap-owned user-assigned identity (identity resource group)."
      }
    },
    "apimIdentityClientId": {
      "type": "string",
      "metadata": {
        "description": "Client ID of the same user-assigned identity."
      }
    },
    "chatModelName": {
      "type": "string",
      "metadata": {
        "description": "Approved chat model name."
      }
    },
    "chatModelVersion": {
      "type": "string",
      "metadata": {
        "description": "Approved chat model version."
      }
    },
    "chatDeploymentSku": {
      "type": "string",
      "metadata": {
        "description": "Approved chat deployment SKU, for example Standard. Global and DataZone SKUs require allowGlobalProcessing."
      }
    },
    "chatDeploymentCapacity": {
      "type": "int",
      "minValue": 1,
      "metadata": {
        "description": "Approved chat deployment capacity in capacity units."
      }
    },
    "allowGlobalProcessing": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Allow deployment SKUs that may process data outside the model account region (Global*, DataZone*)."
      }
    },
    "teams": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/teamConfig"
      },
      "defaultValue": [
        {
          "name": "team-retail",
          "displayName": "Team Retail",
          "tokensPerMinute": 3000,
          "dailyTokenQuota": 30000
        },
        {
          "name": "team-finance",
          "displayName": "Team Finance",
          "tokensPerMinute": 2000,
          "dailyTokenQuota": 20000
        },
        {
          "name": "team-hr",
          "displayName": "Team HR",
          "tokensPerMinute": 1000,
          "dailyTokenQuota": 10000
        }
      ],
      "minLength": 1,
      "metadata": {
        "description": "Team products, each with its own subscription, token rate limit, and daily token quota."
      }
    }
  },
  "variables": {
    "tokenMetricNamespace": "aigov",
    "clientAppAllowlist": [
      "retail-web",
      "finance-batch",
      "hr-assistant"

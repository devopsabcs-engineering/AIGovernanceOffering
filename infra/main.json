    "nameToken": "[format('aigov-{0}-{1}-{2}', parameters('environmentName'), parameters('generation'), parameters('instanceNumber'))]",
    "names": {
      "logAnalytics": "[format('log-{0}', variables('nameToken'))]",
      "appInsights": "[format('appi-{0}', variables('nameToken'))]",
      "apim": "[format('apim-{0}-{1}', variables('nameToken'), parameters('nameSuffix'))]",
      "modelAccount": "[format('aif-{0}-{1}', variables('nameToken'), parameters('nameSuffix'))]",
      "contentSafety": "[format('cs-{0}-{1}', variables('nameToken'), parameters('nameSuffix'))]",
      "chatDeployment": "chat"
    },
    "tags": {
      "aigov-owner": "aigov-lab",
      "aigov-environment": "[parameters('environmentName')]",
      "aigov-generation": "[parameters('generation')]"
    },
    "crossRegionSku": "[or(startsWith(toLower(parameters('chatDeploymentSku')), 'global'), startsWith(toLower(parameters('chatDeploymentSku')), 'datazone'))]",
    "approvedChatDeploymentSku": "[if(and(variables('crossRegionSku'), not(parameters('allowGlobalProcessing'))), fail(format('chatDeploymentSku \"{0}\" can process data outside {1}; set allowGlobalProcessing=true only after that is approved.', parameters('chatDeploymentSku'), parameters('aiLocation'))), parameters('chatDeploymentSku'))]"
  },
  "resources": {

        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "languageVersion": "2.0",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.47.16.16243",
              "templateHash": "5661732081702340555"
            },
            "description": "Platform AI gateway API, model backend, per-team products with token limits, and team subscriptions."
          },
          "definitions": {
            "teamConfig": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "metadata": {
                    "description": "Product ID, also the subscription ID prefix, for example team-retail."
                  }
                },
                "displayName": {
                  "type": "string",
                  "metadata": {
                    "description": "Display name of the product."
                  }
                },
                "tokensPerMinute": {
                  "type": "int",
                  "minValue": 1,
                  "metadata": {
                    "description": "Tokens per minute for each subscription of this product."
                  }
                },
                "dailyTokenQuota": {
                  "type": "int",
                  "minValue": 1,
                  "metadata": {
                    "description": "Daily token quota for each subscription of this product."
                  }
                }
              },
              "metadata": {
                "__bicep_export!": true,
                "description": "One team product with its own subscription, token rate limit, and daily token quota."
              }
            }
          },
          "parameters": {
            "apimName": {
              "type": "string",
              "metadata": {
                "description": "Existing API Management service name."
              }
            },
            "backendUrl": {
              "type": "string",
              "metadata": {
                "description": "Model backend base URL, ending in /openai."
              }
            },
            "apimIdentityClientId": {
              "type": "string",
              "metadata": {
                "description": "Client ID of the APIM user-assigned identity, stored in a non-secret named value used by the API policy."
              }
            },
            "teams": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/teamConfig"
              },
              "minLength": 1,
              "metadata": {
                "description": "Team products to create."
              }
            }
          },
          "variables": {
            "$fxv#0": "<policies>\r\n  <inbound>\r\n    <!--\r\n      Platform AI gateway policy (API scope, owned by infra/modules/platform-api.bicep).\r\n      Product policies (per-team token limits) run first through base.\r\n      The managed identity client ID comes from a Bicep-owned named value;\r\n      no identifier or key is stored in this file.\r\n    -->\r\n    <base />\r\n    <set-header name=\"Ocp-Apim-Subscription-Key\" exists-action=\"delete\" />\r\n    <set-query-parameter name=\"subscription-key\" exists-action=\"delete\" />\r\n    <set-header name=\"api-key\" exists-action=\"delete\" />\r\n    <set-backend-service backend-id=\"ai-gateway-foundry\" />\r\n    <authentication-managed-identity resource=\"https://cognitiveservices.azure.com\" client-id=\"{{ai-gateway-identity-client-id}}\" />\r\n    <!-- ClientApp allowlist: any other x-client-app value is reported as \"unknown\". -->\r\n    <llm-emit-token-metric namespace=\"aigov\">\r\n      <dimension name=\"API ID\" />\r\n      <dimension name=\"Subscription ID\" />\r\n      <dimension name=\"ClientApp\" value='@{ var app = context.Request.Headers.GetValueOrDefault(\"x-client-app\", \"\").Trim().ToLowerInvariant(); return (app == \"retail-web\" || app == \"finance-batch\" || app == \"hr-assistant\") ? app : \"unknown\"; }' />\r\n    </llm-emit-token-metric>\r\n  </inbound>\r\n  <backend>\r\n    <base />\r\n  </backend>\r\n  <outbound>\r\n    <base />\r\n  </outbound>\r\n  <on-error>\r\n    <base />\r\n  </on-error>\r\n</policies>\r\n",
            "apiId": "ai-gateway-api",
            "productPolicyTemplate": "<policies>\r\n  <inbound>\r\n    <!--\r\n      Per-team product policy template (owned by infra/modules/platform-api.bicep).\r\n      Bicep replaces the tokens-per-minute and token-quota placeholders for each team\r\n      product. The counter is keyed on the caller's APIM subscription, so each team\r\n      subscription has its own rate limit and daily quota.\r\n    -->\r\n    <base />\r\n    <llm-token-limit\r\n        counter-key=\"@(context.Subscription.Id)\"\r\n        tokens-per-minute=\"__TOKENS_PER_MINUTE__\"\r\n        token-quota=\"__DAILY_TOKEN_QUOTA__\"\r\n        token-quota-period=\"Daily\"\r\n        estimate-prompt-tokens=\"false\"\r\n        retry-after-header-name=\"Retry-After\"\r\n        tokens-consumed-header-name=\"tokens-consumed\"\r\n        remaining-tokens-header-name=\"remaining-tokens\"\r\n        remaining-quota-tokens-header-name=\"remaining-quota-tokens\" />\r\n  </inbound>\r\n  <backend>\r\n    <base />\r\n  </backend>\r\n  <outbound>\r\n    <base />\r\n  </outbound>\r\n  <on-error>\r\n    <base />\r\n  </on-error>\r\n</policies>\r\n"
          },
          "resources": {
            "apim": {
              "existing": true,
              "type": "Microsoft.ApiManagement/service",
              "apiVersion": "2024-05-01",
              "name": "[parameters('apimName')]"
            },
            "identityClientIdNamedValue": {
              "type": "Microsoft.ApiManagement/service/namedValues",
              "apiVersion": "2024-05-01",
              "name": "[format('{0}/{1}', parameters('apimName'), 'ai-gateway-identity-client-id')]",
              "properties": {
                "displayName": "ai-gateway-identity-client-id",
                "value": "[parameters('apimIdentityClientId')]",
                "secret": false
              }
            },
            "backend": {
              "type": "Microsoft.ApiManagement/service/backends",
              "apiVersion": "2024-05-01",
              "name": "[format('{0}/{1}', parameters('apimName'), 'ai-gateway-foundry')]",
              "properties": {
                "url": "[parameters('backendUrl')]",
                "protocol": "http",
                "description": "Platform model backend; authenticated by the API policy with the user-assigned identity",
                "tls": {
                  "validateCertificateChain": true,
                  "validateCertificateName": true
                }
              }
            },
            "api": {
              "type": "Microsoft.ApiManagement/service/apis",
              "apiVersion": "2024-05-01",
              "name": "[format('{0}/{1}', parameters('apimName'), variables('apiId'))]",
              "properties": {
                "displayName": "AI Gateway (platform)",
                "path": "ai-gateway",
                "protocols": [
                  "https"
                ],
                "subscriptionRequired": true,
                "subscriptionKeyParameterNames": {
                  "header": "Ocp-Apim-Subscription-Key",
                  "query": "subscription-key"
                }
              }
            },
            "chatCompletionsV1": {
              "type": "Microsoft.ApiManagement/service/apis/operations",
              "apiVersion": "2024-05-01",
              "name": "[format('{0}/{1}/{2}', parameters('apimName'), variables('apiId'), 'chat-completions-v1')]",
              "properties": {
                "displayName": "Chat completions (v1)",
                "method": "POST",
                "urlTemplate": "/v1/chat/completions"
              },
              "dependsOn": [
                "api"
              ]
            },
            "chatCompletionsClassic": {
              "type": "Microsoft.ApiManagement/service/apis/operations",
              "apiVersion": "2024-05-01",
              "name": "[format('{0}/{1}/{2}', parameters('apimName'), variables('apiId'), 'chat-completions-classic')]",
              "properties": {
                "displayName": "Chat completions (deployment path)",
                "method": "POST",
                "urlTemplate": "/deployments/{deployment-id}/chat/completions",
                "templateParameters": [
                  {
                    "name": "deployment-id",
                    "type": "string",
                    "required": true
                  }
                ]
              },
              "dependsOn": [
                "api"
              ]
            },
            "apiPolicy": {
              "type": "Microsoft.ApiManagement/service/apis/policies",
              "apiVersion": "2024-05-01",
              "name": "[format('{0}/{1}/{2}', parameters('apimName'), variables('apiId'), 'policy')]",
              "properties": {
                "format": "rawxml",
                "value": "[variables('$fxv#0')]"
              },
              "dependsOn": [
                "api",
                "backend",
                "identityClientIdNamedValue"
              ]
            },
            "products": {
              "copy": {
                "name": "products",
                "count": "[length(parameters('teams'))]"
              },
              "type": "Microsoft.ApiManagement/service/products",
              "apiVersion": "2024-05-01",
              "name": "[format('{0}/{1}', parameters('apimName'), parameters('teams')[copyIndex()].name)]",
              "properties": {
                "displayName": "[parameters('teams')[copyIndex()].displayName]",
                "description": "[format('{0}: {1} tokens per minute, {2} tokens per day', parameters('teams')[copyIndex()].displayName, parameters('teams')[copyIndex()].tokensPerMinute, parameters('teams')[copyIndex()].dailyTokenQuota)]",
                "subscriptionRequired": true,
                "approvalRequired": false,
                "subscriptionsLimit": 1,
                "state": "published"
              }
            },
            "productApis": {
              "copy": {
                "name": "productApis",
                "count": "[length(parameters('teams'))]"
              },
              "type": "Microsoft.ApiManagement/service/products/apis",
              "apiVersion": "2024-05-01",
              "name": "[format('{0}/{1}/{2}', parameters('apimName'), parameters('teams')[copyIndex()].name, variables('apiId'))]",
              "dependsOn": [
                "api",
                "[format('products[{0}]', copyIndex())]"
              ]
            },
            "productPolicies": {
              "copy": {
                "name": "productPolicies",
                "count": "[length(parameters('teams'))]"
              },
              "type": "Microsoft.ApiManagement/service/products/policies",
              "apiVersion": "2024-05-01",
              "name": "[format('{0}/{1}/{2}', parameters('apimName'), parameters('teams')[copyIndex()].name, 'policy')]",
              "properties": {
                "format": "rawxml",
                "value": "[replace(replace(variables('productPolicyTemplate'), '__TOKENS_PER_MINUTE__', string(parameters('teams')[copyIndex()].tokensPerMinute)), '__DAILY_TOKEN_QUOTA__', string(parameters('teams')[copyIndex()].dailyTokenQuota))]"
              },
              "dependsOn": [
                "[format('products[{0}]', copyIndex())]"
              ]
            },
            "teamSubscriptions": {
              "copy": {
                "name": "teamSubscriptions",
                "count": "[length(parameters('teams'))]"
              },
              "type": "Microsoft.ApiManagement/service/subscriptions",
              "apiVersion": "2024-05-01",
              "name": "[format('{0}/{1}', parameters('apimName'), format('{0}-sub', parameters('teams')[copyIndex()].name))]",
              "properties": {
                "displayName": "[format('{0} subscription', parameters('teams')[copyIndex()].displayName)]",
                "scope": "[resourceId('Microsoft.ApiManagement/service/products', parameters('apimName'), parameters('teams')[copyIndex()].name)]",
                "state": "active",
                "allowTracing": false
              },
              "dependsOn": [
                "[format('products[{0}]', copyIndex())]"
              ]
            }
          },
          "outputs": {
            "apiId": {
              "type": "string",
              "value": "[variables('apiId')]"
            },
            "apiPath": {
              "type": "string",
              "value": "[reference('api').path]"
            },
            "backendId": {
              "type": "string",
              "value": "ai-gateway-foundry"
            },
            "identityClientIdNamedValueId": {
              "type": "string",
              "value": "ai-gateway-identity-client-id"
            },
            "productIds": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "copy": {
                "count": "[length(parameters('teams'))]",
                "input": "[parameters('teams')[copyIndex()].name]"
              }
            },
            "subscriptionIds": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "copy": {
                "count": "[length(parameters('teams'))]",
                "input": "[format('{0}-sub', parameters('teams')[copyIndex()].name)]"
              }
            }
          }
        }
      },
      "dependsOn": [
        "ai",
        "apim"
      ]
    }
  },
